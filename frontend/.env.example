# Salin ke .env.local untuk perubahan lokal (file *.local tidak ikut komit).

# Alamat backend yang dipakai proxy Vite saat development.
# Contoh produksi: https://api.contoh.com
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Base URL yang dipakai fetch() di src/api.js.
# Biarkan "/api" agar lewat proxy Vite (tanpa CORS saat dev).
# Isi URL penuh (mis. https://api.contoh.com/api) hanya bila backend
# diakses langsung tanpa proxy.
VITE_API_BASE=/api
