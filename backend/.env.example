# Database PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:123456@127.0.0.1:5432/telegram_access

# JWT
SECRET_KEY=ganti-dengan-string-acak-panjang
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# User awal (dibuat otomatis saat database kosong)
SEED_USERNAME=admin
SEED_PASSWORD=admin123

# n8n webhook — ganti dengan URL workflow n8n kamu (mode: listen / production)
# contoh: http://127.0.0.1:5678/webhook/trigger-api
N8N_WEBHOOK_URL=
